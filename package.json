{
  "name": "redactguard-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "fixtures": "tsx fixtures/generate.ts",
    "test": "vitest run",
    "check-licenses": "tsx scripts/check-licenses.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "1.1.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "jszip": "3.10.2",
    "pdf-lib": "1.17.1",
    "piexifjs": "1.0.6",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
